# Salin ke .env untuk next dev / next build lokal.

# Port server Next.js (`npm run dev` / `npm run start`). Default 3000 jika tidak di-set.
PORT=3000

# URL API yang terlihat browser (wajib untuk klien)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL middleware integrasi data (FastAPI) untuk halaman Sinkron antar database
NEXT_PUBLIC_MIDDLEWARE_URL=http://127.0.0.1:8000

# Prefix nomor ASN otomatis di layar Inbound ASN (format: PREFIX-yyyymmdd-001)
NEXT_PUBLIC_ASN_NO_PREFIX=ASN

# Prefix nomor sales order otomatis di Outbound (format: PREFIX-yyyymmdd-001)
NEXT_PUBLIC_SALES_ORDER_NO_PREFIX=SO

# Prefix nomor wave otomatis di Outbound — Waves (format: PREFIX-yyyymmdd-001)
NEXT_PUBLIC_WAVE_NO_PREFIX=WAVE

# Hanya dipakai jika server Next memanggil API secara server-side (proxy/internal).
# Di docker-compose di-set ke http://api:4000.
API_INTERNAL_URL=http://localhost:4000
